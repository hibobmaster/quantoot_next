+++ b/shared/src/commonMain/kotlin/com/quanquan/quantoot/ui/TemporaryProfileMotionProbe.kt
@@ -0,0 +1,154 @@
+package com.quanquan.quantoot.ui
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.gestures.animateScrollBy
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.relocation.BringIntoViewRequester
+import androidx.compose.foundation.relocation.bringIntoViewRequester
+import androidx.compose.material3.*
+import androidx.compose.material3.pulltorefresh.PullToRefreshBox
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.geometry.Rect
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import kotlin.math.roundToInt
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+// TEMPORARY native acceptance probe. Remove this file and its launch wiring before integration.
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun TemporaryProfileMotionProbe(initialTallHeader: Boolean = false, initialLargeText: Boolean = false) {
+    val state = rememberProfileScrollState()
+    val scope = rememberCoroutineScope()
+    var tall by remember { mutableStateOf(initialTallHeader) }
+    var large by remember { mutableStateOf(initialLargeText) }
+    var loading by remember { mutableStateOf(false) }
+    var refreshing by remember { mutableStateOf(false) }
+    var refreshCount by remember { mutableIntStateOf(0) }
+    var refreshAt by remember { mutableStateOf("none") }
+    var headerHits by remember { mutableIntStateOf(0) }
+    var bodyHits by remember { mutableIntStateOf(0) }
+    var bodyBounds by remember { mutableStateOf<Rect?>(null) }
+    val headerTop = remember { BringIntoViewRequester() }
+    val headerEnd = remember { BringIntoViewRequester() }
+    val bodyAction = remember { BringIntoViewRequester() }
+    val density = LocalDensity.current
+    CompositionLocalProvider(LocalDensity provides Density(density.density, if (large) 1.8f else density.fontScale)) {
+        Column(Modifier.fillMaxSize().testTag("probe:screen")) {
+            Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState())) {
+                TextButton({ tall = !tall }, Modifier.testTag("probe:toggle-tall")) { Text(if (tall) "Normal header" else "Tall header") }
+                TextButton({ large = !large }, Modifier.testTag("probe:toggle-large")) { Text(if (large) "Normal text" else "Large text") }
+                TextButton({ loading = !loading }, Modifier.testTag("probe:toggle-loading")) { Text(if (loading) "Ready body" else "Loading body") }
+            }
+            Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState())) {
+                TextButton({ scope.launch { headerTop.bringIntoView() } }, Modifier.testTag("probe:reveal-header-top")) { Text("Top") }
+                TextButton({ scope.launch { headerEnd.bringIntoView() } }, Modifier.testTag("probe:reveal-header-end")) { Text("End") }
+                TextButton({ scope.launch { bodyAction.bringIntoView() } }, Modifier.testTag("probe:reveal-body")) { Text("Body") }
+                TextButton({
+                    scope.launch {
+                        val bottom = bodyBounds?.bottom ?: return@launch
+                        state.animateScrollBy(bottom - state.geometry.viewportHeight - with(density) { 20.dp.toPx() })
+                    }
+                }, Modifier.testTag("probe:clip-body")) { Text("Clip") }
+            }
+            val geometry = state.geometry
+            Text(
+                "collapse=${geometry.collapsed.roundToInt()};header=${geometry.headerHeight};tabs=${geometry.categoryTop.roundToInt()};" +
+                    "bodyIndex=${state.bodyState.firstVisibleItemIndex};bodyOffset=${state.bodyState.firstVisibleItemScrollOffset};" +
+                    "refresh=$refreshCount;refreshAt=$refreshAt;headerHits=$headerHits;bodyHits=$bodyHits;" +
+                    "bodyBottom=${bodyBounds?.bottom?.roundToInt() ?: -1};viewport=${geometry.viewportHeight}",
+                Modifier.fillMaxWidth().testTag("probe:metrics"), fontSize = 11.sp,
+            )
+            PullToRefreshBox(
+                isRefreshing = refreshing,
+                onRefresh = {
+                    refreshCount++
+                    refreshAt = "${state.geometry.collapsed.roundToInt()},${state.bodyState.firstVisibleItemIndex},${state.bodyState.firstVisibleItemScrollOffset}"
+                    scope.launch { refreshing = true; delay(250); refreshing = false }
+                },
+                modifier = Modifier.weight(1f).fillMaxWidth(),
+            ) {
+                ProfileScrollLayout(
+                    state = state,
+                    modifier = Modifier.fillMaxSize().testTag("probe:viewport"),
+                    header = {
+                        Column(Modifier.fillMaxWidth().background(Color(0xFFE7F2FA)).padding(16.dp)) {
+                            Text("TEMPORARY PROFILE MOTION PROBE", style = MaterialTheme.typography.titleMedium)
+                            Button(
+                                { headerHits++ },
+                                Modifier.testTag("probe:header-top-action").bringIntoViewRequester(headerTop),
+                            ) { Text("Header top action") }
+                            Spacer(Modifier.height(if (tall) 880.dp else 110.dp))
+                            Text("Naturally measured profile fields. The header may grow beyond one viewport.")
+                            Button(
+                                { headerHits++ },
+                                Modifier.testTag("probe:header-end-action").bringIntoViewRequester(headerEnd),
+                            ) { Text("Header end action") }
+                        }
+                    },
+                ) { selection ->
+                    if (loading) {
+                        item("loading") { Text("Loading body", Modifier.padding(24.dp).testTag("probe:loading")) }
+                    } else when (selection.category) {
+                        ProfileCategory.Media -> item("empty") {
+                            Text("Empty body", Modifier.padding(24.dp).testTag("probe:empty"))
+                        }
+                        ProfileCategory.Featured, ProfileCategory.About -> item("short") {
+                            Column(Modifier.padding(16.dp)) {
+                                Text("Short ${selection.category.name} body")
+                                Button({ bodyHits++ }, Modifier.testTag("probe:short-action")) { Text("Short body action") }
+                            }
+                        }
+                        ProfileCategory.Posts, ProfileCategory.Activity -> {
+                            if (selection.category == ProfileCategory.Activity) item("filters") {
+                                Row(Modifier.horizontalScroll(rememberScrollState())) {
+                                    FilterChip(
+                                        selection.showReplies,
+                                        { scope.launch { state.select(selection.copy(showReplies = !selection.showReplies)) } },
+                                        label = { Text("Replies") }, modifier = Modifier.testTag("probe:filter-replies"),
+                                    )
+                                    FilterChip(
+                                        selection.showBoosts,
+                                        { scope.launch { state.select(selection.copy(showBoosts = !selection.showBoosts)) } },
+                                        label = { Text("Boosts") }, modifier = Modifier.testTag("probe:filter-boosts"),
+                                    )
+                                }
+                            }
+                            repeat(18) { index ->
+                                item("row:$index") {
+                                    Column(
+                                        Modifier.fillMaxWidth().background(if (index % 2 == 0) Color(0xFFF2F5EB) else Color.White)
+                                            .padding(16.dp).testTag("probe:row:$index"),
+                                    ) {
+                                        Text("${selection.category.name} body row $index", style = MaterialTheme.typography.titleMedium)
+                                        Spacer(Modifier.height(if (index == 0) 420.dp else 240.dp))
+                                        Button(
+                                            { bodyHits++ },
+                                            Modifier.testTag("probe:body-action:$index")
+                                                .then(if (index == 0) Modifier.bringIntoViewRequester(bodyAction).onGloballyPositioned {
+                                                    val parent = state.coordinates
+                                                    if (parent != null && parent.isAttached) {
+                                                        val position = parent.localPositionOf(it)
+                                                        bodyBounds = Rect(position.x, position.y, position.x + it.size.width, position.y + it.size.height)
+                                                    }
+                                                } else Modifier),
+                                        ) { Text("Body action $index") }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
