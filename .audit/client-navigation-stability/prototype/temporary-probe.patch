diff --git a/iosApp/QuanTootTests/TemporaryProfileAccessibilityProbeTests.swift b/iosApp/QuanTootTests/TemporaryProfileAccessibilityProbeTests.swift
new file mode 100644
index 0000000..b9cb40a
--- /dev/null
+++ b/iosApp/QuanTootTests/TemporaryProfileAccessibilityProbeTests.swift
@@ -0,0 +1,202 @@
+import XCTest
+import UIKit
+import QuanTootShared
+
+// TEMPORARY: invokes public UIKit accessibility actions on actual Compose accessibility elements.
+@MainActor
+final class TemporaryProfileAccessibilityProbeTests: XCTestCase {
+    private var probeWindow: UIWindow?
+    private weak var previousKeyWindow: UIWindow?
+
+    override func tearDown() {
+        probeWindow?.isHidden = true
+        probeWindow = nil
+        previousKeyWindow?.makeKeyAndVisible()
+        super.tearDown()
+    }
+
+    func testNativeAccessibilityScrollMovesEmptyHeaderDownAndUp() async throws {
+        try await host()
+        try await activate("profile:category:Media")
+        try await settle()
+        let before = try number("collapse")
+        let viewport = try requireElement("probe:viewport")
+        XCTAssertTrue(viewport.accessibilityScroll(.down))
+        await expectEventually { ((try? self.number("collapse")) ?? 0) > before + 20 }
+        try await settle()
+        XCTAssertEqual(try number("bodyIndex"), 0)
+        XCTAssertEqual(try number("bodyOffset"), 0)
+        let down = try number("collapse")
+        XCTAssertTrue(try requireElement("probe:viewport").accessibilityScroll(.up))
+        await expectEventually { ((try? self.number("collapse")) ?? down) < down - 20 }
+        try await settle()
+        attachTree("Native empty-body accessibility scrolling")
+    }
+
+    func testNativeAccessibilityScrollCrossesIntoBodyAndCanActivateActions() async throws {
+        try await host()
+        XCTAssertTrue(try requireElement("probe:viewport").accessibilityScroll(.down))
+        try await settle()
+        XCTAssertEqual(try number("collapse"), try number("header"), accuracy: 2)
+        XCTAssertTrue(try number("bodyIndex") > 0 || number("bodyOffset") > 0)
+        try await activate("probe:reveal-body")
+        await expectEventually { self.visible("probe:body-action:0") }
+        try await settle()
+        try await activate("probe:body-action:0")
+        XCTAssertEqual(try number("bodyHits"), 1)
+        let body = try requireElement("probe:body-action:0").accessibilityFrame
+        let viewport = try requireElement("probe:viewport").accessibilityFrame
+        let tabs = try requireElement("profile:categories").accessibilityFrame
+        XCTAssertGreaterThanOrEqual(body.minY, tabs.maxY - 2)
+        XCTAssertLessThanOrEqual(body.maxY, viewport.maxY + 2)
+        attachTree("Native body scroll and activation")
+    }
+
+    func testNativeActivationBringsTallHeaderActionsIntoViewAtLargeText() async throws {
+        try await host(tall: true, large: true)
+        XCTAssertFalse(visible("probe:header-end-action"))
+        try await activate("probe:reveal-header-end")
+        await expectEventually { self.visible("probe:header-end-action") }
+        try await settle()
+        XCTAssertGreaterThan(try number("collapse"), 500)
+        try await activate("probe:header-end-action")
+        XCTAssertEqual(try number("headerHits"), 1)
+        try await activate("probe:reveal-header-top")
+        await expectEventually { self.visible("probe:header-top-action") }
+        try await settle()
+        try await activate("probe:header-top-action")
+        XCTAssertEqual(try number("headerHits"), 2)
+        attachTree("Native activation and tall-header bring-into-view")
+    }
+
+    func testClippedBodyIsNotAnAccessibleActionUntilRevealed() async throws {
+        try await host()
+        XCTAssertFalse(visible("probe:body-action:0"))
+        XCTAssertEqual(try number("bodyHits"), 0)
+        try await activate("probe:reveal-body")
+        await expectEventually { self.visible("probe:body-action:0") }
+        try await settle()
+        try await activate("probe:clip-body")
+        try await settle()
+        XCTAssertGreaterThan(try number("bodyBottom"), try number("viewport") + 10,
+                             "The native focus check must start with an actually clipped action.")
+        let action = try requireElement("probe:body-action:0")
+        action.accessibilityElementDidBecomeFocused()
+        NotificationCenter.default.post(
+            name: UIAccessibility.elementFocusedNotification,
+            object: nil,
+            userInfo: [UIAccessibility.focusedElementUserInfoKey: action]
+        )
+        await expectEventually {
+            guard let bottom = try? self.number("bodyBottom"), let viewport = try? self.number("viewport") else { return false }
+            return bottom <= viewport + 2
+        }
+        try await settle()
+        XCTAssertTrue(visible("probe:body-action:0"))
+        XCTAssertTrue(action.accessibilityActivate())
+        XCTAssertEqual(try number("bodyHits"), 1)
+        attachTree("Clipped native action visibility")
+    }
+
+    private func host(tall: Bool = false, large: Bool = false) async throws {
+        continueAfterFailure = false
+        let scene = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.first
+        previousKeyWindow = scene?.windows.first(where: \.isKeyWindow)
+        let window = scene.map { UIWindow(windowScene: $0) } ?? UIWindow(frame: UIScreen.main.bounds)
+        window.frame = UIScreen.main.bounds
+        window.windowLevel = .normal + 1
+        window.rootViewController = TemporaryProfileMotionProbeControllerKt.temporaryProfileMotionProbeViewController(tallHeader: tall, largeText: large)
+        probeWindow = window
+        window.makeKeyAndVisible()
+        window.rootViewController?.view.layoutIfNeeded()
+        await expectEventually { self.find("probe:metrics") != nil }
+        try await settle()
+    }
+
+    private func elements() -> [NSObject] {
+        guard let probeWindow else { return [] }
+        var found: [NSObject] = []
+        var seen = Set<ObjectIdentifier>()
+        func walk(_ object: NSObject) {
+            guard seen.insert(ObjectIdentifier(object)).inserted else { return }
+            found.append(object)
+            if let children = object.accessibilityElements {
+                for child in children { if let child = child as? NSObject { walk(child) } }
+            } else {
+                let count = object.accessibilityElementCount()
+                if count > 0 && count < 1000 {
+                    for index in 0..<count {
+                        if let child = object.accessibilityElement(at: index) as? NSObject { walk(child) }
+                    }
+                }
+            }
+            if let view = object as? UIView { view.subviews.forEach(walk) }
+        }
+        walk(probeWindow)
+        return found
+    }
+
+    private func find(_ identifier: String) -> NSObject? {
+        elements().first { ($0 as? UIAccessibilityIdentification)?.accessibilityIdentifier == identifier }
+    }
+
+    private func requireElement(_ identifier: String) throws -> NSObject {
+        try XCTUnwrap(find(identifier), "Missing native accessibility element \(identifier)")
+    }
+
+    private func visible(_ identifier: String) -> Bool {
+        guard let element = find(identifier), element.isAccessibilityElement,
+              let viewport = find("probe:viewport") else { return false }
+        let frame = element.accessibilityFrame
+        return !frame.isEmpty && viewport.accessibilityFrame.intersects(frame)
+    }
+
+    private func activate(_ identifier: String) async throws {
+        XCTAssertTrue(try requireElement(identifier).accessibilityActivate(), identifier)
+        try await settle()
+    }
+
+    private func number(_ key: String) throws -> Double {
+        let label = try XCTUnwrap(requireElement("probe:metrics").accessibilityLabel)
+        let values = Dictionary(uniqueKeysWithValues: label.split(separator: ";").compactMap { item -> (String, String)? in
+            let pair = item.split(separator: "=", maxSplits: 1).map(String.init)
+            return pair.count == 2 ? (pair[0], pair[1]) : nil
+        })
+        return try XCTUnwrap(values[key].flatMap(Double.init), "Missing numeric metric \(key): \(label)")
+    }
+
+    private func eventually(_ condition: () -> Bool) async -> Bool {
+        let deadline = Date().addingTimeInterval(8)
+        while Date() < deadline {
+            if condition() { return true }
+            try? await Task.sleep(nanoseconds: 40_000_000)
+        }
+        return false
+    }
+
+    private func expectEventually(_ condition: () -> Bool, file: StaticString = #filePath, line: UInt = #line) async {
+        let succeeded = await eventually(condition)
+        XCTAssertTrue(succeeded, file: file, line: line)
+    }
+
+    private func settle() async throws {
+        var last = ""
+        var since = Date()
+        let settled = await eventually {
+            let current = self.find("probe:metrics")?.accessibilityLabel ?? ""
+            if current != last { last = current; since = Date(); return false }
+            return !current.isEmpty && Date().timeIntervalSince(since) > 0.6
+        }
+        XCTAssertTrue(settled)
+    }
+
+    private func attachTree(_ name: String) {
+        let dump = elements().map {
+            "id=\(($0 as? UIAccessibilityIdentification)?.accessibilityIdentifier ?? "");element=\($0.isAccessibilityElement);frame=\($0.accessibilityFrame);label=\($0.accessibilityLabel ?? "")"
+        }.joined(separator: "\n")
+        let attachment = XCTAttachment(string: dump)
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+    }
+}
