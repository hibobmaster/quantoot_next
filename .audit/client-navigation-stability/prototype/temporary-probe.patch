+import XCTest
+
+// TEMPORARY: source-only native probe. Remove with the argument-selected probe before integration.
+@MainActor
+final class TemporaryProfileMotionProbeTests: XCTestCase {
+    func testHeaderOriginFlingContinuesIntoBodyAndReverses() throws {
+        let app = launch()
+        let viewport = element("probe:viewport", app)
+        let origin = viewport.frame.minY + 180
+        drag(app, fromY: origin, toY: viewport.frame.minY + 15, velocity: .fast)
+        waitForIdle(app)
+        let forward = metrics(app)
+        XCTAssertEqual(number("collapse", forward), number("header", forward), accuracy: 2)
+        XCTAssertTrue(number("bodyIndex", forward) > 0 || number("bodyOffset", forward) > 80,
+                      "A fling that starts over the header must continue into the lazy body.")
+        drag(app, fromY: viewport.frame.minY + 50, toY: viewport.frame.maxY - 30, velocity: .fast)
+        waitForIdle(app)
+        let reverse = metrics(app)
+        XCTAssertTrue(number("bodyIndex", reverse) < number("bodyIndex", forward) ||
+                      number("bodyOffset", reverse) < number("bodyOffset", forward) ||
+                      number("collapse", reverse) < number("collapse", forward))
+        capture("Header-origin fling and reverse", app)
+    }
+
+    func testEmptyBodyScrollAndAllCategorySwitchesKeepTheRowStable() throws {
+        let app = launch()
+        let viewport = element("probe:viewport", app)
+        drag(app, fromY: viewport.frame.maxY - 40, toY: viewport.frame.maxY - 120, velocity: .slow)
+        waitForIdle(app)
+        let anchor = element("profile:category:Posts", app).frame.midY
+        for category in ["Media", "Featured", "Activity", "About", "Posts", "Media"] {
+            let tab = revealCategory(category, app)
+            tab.tap()
+            waitForIdle(app)
+            XCTAssertEqual(tab.frame.midY, anchor, accuracy: 3, category)
+            XCTAssertEqual(number("bodyIndex", metrics(app)), 0)
+            XCTAssertEqual(number("bodyOffset", metrics(app)), 0)
+        }
+        let before = number("collapse", metrics(app))
+        drag(app, fromY: viewport.frame.maxY - 25, toY: viewport.frame.maxY - 145, velocity: .slow)
+        waitForIdle(app)
+        XCTAssertGreaterThan(number("collapse", metrics(app)), before + 40)
+        XCTAssertEqual(number("bodyOffset", metrics(app)), 0)
+        capture("Empty body header travel", app)
+    }
+
+    func testLoadingAndActivityFilterSwitchesKeepTheHeaderStable() throws {
+        let app = launch()
+        let viewport = element("probe:viewport", app)
+        drag(app, fromY: viewport.frame.maxY - 40, toY: viewport.frame.maxY - 200, velocity: .slow)
+        waitForIdle(app)
+        revealCategory("Activity", app).tap()
+        let before = number("tabs", metrics(app))
+        element("probe:filter-replies", app).tap()
+        waitForIdle(app)
+        XCTAssertEqual(number("tabs", metrics(app)), before, accuracy: 2)
+        element("probe:toggle-loading", app).tap()
+        waitForIdle(app)
+        XCTAssertEqual(number("tabs", metrics(app)), before, accuracy: 2)
+        element("probe:toggle-loading", app).tap()
+        waitForIdle(app)
+        XCTAssertEqual(number("tabs", metrics(app)), before, accuracy: 2)
+        capture("Loading and Activity replacement", app)
+    }
+
+    func testRefreshWaitsForBothHeaderAndBodyToReachTheBeginning() throws {
+        let app = launch()
+        let viewport = element("probe:viewport", app)
+        for _ in 0..<3 {
+            drag(app, fromY: viewport.frame.maxY - 30, toY: viewport.frame.minY + 30, velocity: .fast)
+        }
+        waitForIdle(app)
+        let initial = metrics(app)
+        XCTAssertGreaterThan(number("bodyIndex", initial), 1)
+        drag(app, fromY: viewport.frame.minY + 80, toY: viewport.frame.minY + 160, velocity: .slow)
+        waitForIdle(app)
+        XCTAssertEqual(number("refresh", metrics(app)), 0)
+        for _ in 0..<35 {
+            let current = metrics(app)
+            if number("bodyIndex", current) == 0 && number("bodyOffset", current) == 0 && number("collapse", current) == 0 { break }
+            drag(app, fromY: viewport.frame.minY + 50, toY: viewport.frame.maxY - 40, velocity: .slow)
+            waitForIdle(app)
+        }
+        let atTop = metrics(app)
+        XCTAssertEqual(number("collapse", atTop), 0)
+        XCTAssertEqual(number("bodyIndex", atTop), 0)
+        XCTAssertEqual(number("bodyOffset", atTop), 0)
+        let refreshBefore = number("refresh", atTop)
+        drag(app, fromY: viewport.frame.minY + 60, toY: viewport.frame.maxY - 35, velocity: .slow)
+        XCTAssertTrue(waitUntil { self.number("refresh", self.metrics(app)) > refreshBefore })
+        XCTAssertEqual(metrics(app)["refreshAt"], "0,0,0")
+        capture("Refresh callback at the true beginning", app)
+    }
+
+    func testClippedActionsAndBringIntoView() throws {
+        let app = launch()
+        let hiddenBodyAction = element("probe:body-action:0", app)
+        XCTAssertFalse(hiddenBodyAction.exists && hiddenBodyAction.isHittable)
+        element("probe:header-top-action", app).tap()
+        XCTAssertEqual(number("headerHits", metrics(app)), 1)
+        XCTAssertEqual(number("bodyHits", metrics(app)), 0)
+        element("probe:reveal-body", app).tap()
+        XCTAssertTrue(waitUntil { hiddenBodyAction.exists && hiddenBodyAction.isHittable })
+        waitForIdle(app)
+        let tabs = element("profile:categories", app)
+        let viewport = element("probe:viewport", app)
+        XCTAssertGreaterThanOrEqual(hiddenBodyAction.frame.minY, tabs.frame.maxY - 2)
+        XCTAssertLessThanOrEqual(hiddenBodyAction.frame.maxY, viewport.frame.maxY + 2)
+        hiddenBodyAction.tap()
+        XCTAssertEqual(number("bodyHits", metrics(app)), 1)
+        element("probe:reveal-header-top", app).tap()
+        XCTAssertTrue(waitUntil { self.element("probe:header-top-action", app).isHittable })
+        capture("Clipped actions after bring-into-view", app)
+    }
+
+    func testTallHeaderAndLargeTextRemainUncapped() throws {
+        let app = launch(["--probe-tall-header", "--probe-large-text"])
+        let end = element("probe:header-end-action", app)
+        XCTAssertFalse(end.exists && end.isHittable)
+        element("probe:reveal-header-end", app).tap()
+        XCTAssertTrue(waitUntil { end.exists && end.isHittable })
+        waitForIdle(app)
+        XCTAssertGreaterThan(number("collapse", metrics(app)), 500)
+        end.tap()
+        XCTAssertEqual(number("headerHits", metrics(app)), 1)
+        capture("Large text and naturally tall header", app)
+    }
+
+    private func launch(_ arguments: [String] = []) -> XCUIApplication {
+        continueAfterFailure = false
+        let app = XCUIApplication()
+        app.launchArguments = ["--temporary-profile-motion-probe"] + arguments
+        app.launch()
+        XCTAssertTrue(element("probe:metrics", app).waitForExistence(timeout: 15))
+        waitForIdle(app)
+        return app
+    }
+
+    private func element(_ identifier: String, _ app: XCUIApplication) -> XCUIElement {
+        app.descendants(matching: .any).matching(identifier: identifier).firstMatch
+    }
+
+    private func revealCategory(_ name: String, _ app: XCUIApplication) -> XCUIElement {
+        let tab = element("profile:category:\(name)", app)
+        let row = element("profile:categories", app)
+        for _ in 0..<4 {
+            if tab.exists && tab.isHittable { return tab }
+            let right = name != "Posts" && name != "Media"
+            let y = row.frame.midY
+            let from = app.coordinate(withNormalizedOffset: .zero).withOffset(CGVector(dx: app.frame.width * (right ? 0.85 : 0.15), dy: y))
+            let to = app.coordinate(withNormalizedOffset: .zero).withOffset(CGVector(dx: app.frame.width * (right ? 0.15 : 0.85), dy: y))
+            from.press(forDuration: 0.05, thenDragTo: to, withVelocity: .slow, thenHoldForDuration: 0.2)
+        }
+        XCTAssertTrue(tab.exists && tab.isHittable, name)
+        return tab
+    }
+
+    private func drag(_ app: XCUIApplication, fromY: CGFloat, toY: CGFloat, velocity: XCUIGestureVelocity) {
+        let base = app.coordinate(withNormalizedOffset: .zero)
+        base.withOffset(CGVector(dx: app.frame.width * 0.88, dy: fromY))
+            .press(forDuration: 0.03, thenDragTo: base.withOffset(CGVector(dx: app.frame.width * 0.88, dy: toY)),
+                   withVelocity: velocity, thenHoldForDuration: 0)
+    }
+
+    private func metrics(_ app: XCUIApplication) -> [String: String] {
+        Dictionary(uniqueKeysWithValues: element("probe:metrics", app).label.split(separator: ";").compactMap {
+            let pair = $0.split(separator: "=", maxSplits: 1).map(String.init)
+            return pair.count == 2 ? (pair[0], pair[1]) : nil
+        })
+    }
+
+    private func number(_ key: String, _ values: [String: String]) -> Double {
+        guard let value = values[key], let result = Double(value) else {
+            XCTFail("Missing numeric probe metric \(key): \(values)")
+            return .nan
+        }
+        return result
+    }
+
+    private func waitForIdle(_ app: XCUIApplication) {
+        var previous = ""
+        var stableSince = Date()
+        XCTAssertTrue(waitUntil {
+            let value = self.element("probe:metrics", app).label
+            if value != previous { previous = value; stableSince = Date(); return false }
+            return Date().timeIntervalSince(stableSince) > 0.6
+        })
+    }
+
+    private func waitUntil(_ condition: @escaping () -> Bool) -> Bool {
+        let expectation = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in condition() }, object: nil)
+        return XCTWaiter.wait(for: [expectation], timeout: 8) == .completed
+    }
+
+    private func capture(_ name: String, _ app: XCUIApplication) {
+        let image = XCTAttachment(screenshot: app.screenshot())
+        image.name = name
+        image.lifetime = .keepAlways
+        add(image)
+        let values = XCTAttachment(string: element("probe:metrics", app).label)
+        values.name = name + " metrics"
+        values.lifetime = .keepAlways
+        add(values)
+    }
+}
