diff --git a/shared/src/commonMain/kotlin/com/quanquan/quantoot/ui/TemporaryProfileMotionProbe.kt b/shared/src/commonMain/kotlin/com/quanquan/quantoot/ui/TemporaryProfileMotionProbe.kt
